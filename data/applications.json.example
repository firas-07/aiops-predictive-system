{
  "chatgpt-azure-prod": {
    "id": "chatgpt-azure-prod",
    "name": "ChatGPT Azure Prod (Default)",
    "telemetry_source": "csv",
    "csv_file_path": "data/raw/chatgpt_azure_synthetic_telemetry_50000.csv",
    "azure_config": {
      "tenant_id": "",
      "client_id": "",
      "client_secret": "",
      "subscription_id": "",
      "resource_group": "",
      "resource_name": "chatgpt-prod-insights",
      "telemetry_service": "azure_monitor"
    },
    "thresholds": {
      "cpu_percent": {
        "metric": "cpu_percent",
        "threshold_percentage": 80.0,
        "operational_limit": 100.0,
        "operator": ">=",
        "enabled": true,
        "unit": "%"
      },
      "memory_percent": {
        "metric": "memory_percent",
        "threshold_percentage": 85.0,
        "operational_limit": 100.0,
        "operator": ">=",
        "enabled": true,
        "unit": "%"
      },
      "disk_io_mb_s": {
        "metric": "disk_io_mb_s",
        "threshold_percentage": 80.0,
        "operational_limit": 80.0,
        "operator": ">=",
        "enabled": true,
        "unit": "MB/s"
      },
      "latency_ms": {
        "metric": "latency_ms",
        "threshold_percentage": 80.0,
        "operational_limit": 500.0,
        "operator": ">=",
        "enabled": true,
        "unit": "ms"
      },
      "http_errors": {
        "metric": "http_errors",
        "threshold_percentage": 80.0,
        "operational_limit": 50.0,
        "operator": ">=",
        "enabled": true,
        "unit": "count/min"
      },
      "http_success": {
        "metric": "http_success",
        "threshold_percentage": 30.0,
        "operational_limit": 3500.0,
        "operator": "<=",
        "enabled": true,
        "unit": "req/min"
      },
      "network_mb_s": {
        "metric": "network_mb_s",
        "threshold_percentage": 80.0,
        "operational_limit": 70.0,
        "operator": ">=",
        "enabled": true,
        "unit": "MB/s"
      },
      "request_volume": {
        "metric": "request_volume",
        "threshold_percentage": 90.0,
        "operational_limit": 4000.0,
        "operator": ">=",
        "enabled": true,
        "unit": "req/min"
      }
    },
    "created_at": "2026-09-26T00:00:00.000000",
    "updated_at": "2026-09-26T00:00:00.000000"
  }
}
